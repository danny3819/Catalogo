<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
</head>
<body>

<h2>Login</h2>

<form method="POST" action="/login">
  <input name="user" placeholder="Usuario" required>
  <input type="password" name="password" placeholder="Contraseña" required>
  <button>Entrar</button>
</form>

<% if (error) { %>
  <p style="color:red;"><%= error %></p>
<% } %>

</body>
</html>